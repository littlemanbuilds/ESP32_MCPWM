{
  "name": "ESP32_MCPWM",
  "version": "2.1.2",
  "description": "Explicit Arduino-ESP32 MCPWM H-bridge control with structured operation results, software and hardware fault paths, coast/brake modes, runtime retuning, capture, and diagnostics.",
  "keywords": [
    "arduino",
    "esp32",
    "esp32-s3",
    "motor",
    "mcpwm",
    "h-bridge",
    "bts7960",
    "ibt-2",
    "braking",
    "fault",
    "motor-control"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/littlemanbuilds/ESP32_MCPWM.git"
  },
  "authors": [
    {
      "name": "Little Man Builds (Darren Osborne)",
      "email": "littlemanbuilds@gmail.com",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "build": {
    "includeDir": "src"
  },
  "export": {
    "include": [
      ".clang-format",
      ".github/workflows/ci.yml",
      ".gitignore",
      "CHANGELOG.md",
      "LICENSE",
      "README.md",
      "RELEASE_CHECKLIST.md",
      "examples/01_BasicMotorControl/01_BasicMotorControl.ino",
      "examples/02_FreewheelAndDitherBrake/02_FreewheelAndDitherBrake.ino",
      "examples/03_FaultInputSafety/03_FaultInputSafety.ino",
      "examples/04_RuntimeFrequencyChange/04_RuntimeFrequencyChange.ino",
      "examples/05_CaptureInput/05_CaptureInput.ino",
      "examples/06_TwoMotors/06_TwoMotors.ino",
      "keywords.txt",
      "library.json",
      "library.properties",
      "platformio.ini",
      "src/ESP32_MCPWM.h",
      "src/HBridgeMotor.cpp",
      "src/HBridgeMotor.h",
      "src/IMotorDriver.h"
    ]
  },
  "examples": [
    "examples/01_BasicMotorControl/01_BasicMotorControl.ino",
    "examples/02_FreewheelAndDitherBrake/02_FreewheelAndDitherBrake.ino",
    "examples/03_FaultInputSafety/03_FaultInputSafety.ino",
    "examples/04_RuntimeFrequencyChange/04_RuntimeFrequencyChange.ino",
    "examples/05_CaptureInput/05_CaptureInput.ino",
    "examples/06_TwoMotors/06_TwoMotors.ino"
  ],
  "headers": ["ESP32_MCPWM.h"]
}
